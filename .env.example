# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployed site. Used for canonical URLs, the sitemap and
# Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://joinly.co.uk

# Shown on the site as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=hello@joinly.co.uk

# ---------------------------------------------------------------------------
# Where form submissions go
# ---------------------------------------------------------------------------
# IMPORTANT: in production at least one of the two options below MUST be set.
# With neither configured the forms return an honest 503 rather than showing a
# thank-you message for a submission nobody would ever read.

# Option 1 — email notifications via Resend (https://resend.com).
# All three are required together. SUBMISSIONS_FROM_EMAIL must be on a domain
# you have verified with Resend.
RESEND_API_KEY=
SUBMISSIONS_TO_EMAIL=you@yourdomain.co.uk
SUBMISSIONS_FROM_EMAIL=jobs@yourdomain.co.uk

# Option 2 — POST every submission to a webhook (Zapier, Make, a Google Sheet,
# your own API). Can be used on its own or alongside email.
SUBMISSIONS_WEBHOOK_URL=
# Optional. When set, each request carries an HMAC-SHA256 of the body in the
# X-Joinly-Signature header so the receiver can verify it came from us.
SUBMISSIONS_WEBHOOK_SECRET=

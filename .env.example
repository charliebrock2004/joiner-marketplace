# ---------------------------------------------------------------------------
# Database  (REQUIRED in production)
# ---------------------------------------------------------------------------
# Any Postgres connection string — Supabase, Neon, Vercel Postgres.
# Use the POOLED connection string on serverless, not the direct one.
#
# If this is unset the app falls back to PGlite, an in-process Postgres stored
# under .data/postgres. That is intended for local development only: on Vercel
# the filesystem is ephemeral, so every deploy would start with an empty
# database.
DATABASE_URL=

# Optional. Max pooled connections per instance (default 5). Keep it low on
# serverless — many instances each hold their own pool.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployed site. Used for canonical URLs, the sitemap and
# Open Graph tags. A trailing slash is fine — it is stripped.
#
# If this is unset, empty or not a valid URL, the build does NOT fail. It falls
# back to Vercel's own domain (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL, then
# NEXT_PUBLIC_VERCEL_URL) and finally to http://localhost:3000, logging a
# warning. Set it to your real domain before launch.
NEXT_PUBLIC_SITE_URL=https://your-domain.co.uk

# Shown on the site as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=hello@tradezy.co.uk

# ---------------------------------------------------------------------------
# Photo uploads
# ---------------------------------------------------------------------------
# Set automatically by Vercel once you create a Blob store in the dashboard.
# Without it, uploads are written to .data/uploads and served from
# /api/uploads — fine locally, but ephemeral on Vercel, so job photos and
# portfolios would disappear between deploys.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Legacy lead-capture notifications  (optional)
# ---------------------------------------------------------------------------
# These power /api/jobs, /api/joiners and /api/waitlist. The waitlist form on
# the homepage still uses this; the job and joiner endpoints are superseded by
# real accounts and are kept only so existing integrations keep working.
#
# Without one of these configured those endpoints return an honest 503 rather
# than pretending to have accepted a submission.
RESEND_API_KEY=
SUBMISSIONS_TO_EMAIL=you@yourdomain.co.uk
SUBMISSIONS_FROM_EMAIL=noreply@yourdomain.co.uk

SUBMISSIONS_WEBHOOK_URL=
# Optional. When set, each request carries an HMAC-SHA256 of the body in the
# X-Tradezy-Signature header so the receiver can verify it came from us.
SUBMISSIONS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Guards  (leave unset)
# ---------------------------------------------------------------------------
# ALLOW_DEMO_SEED=yes       lets `npm run db:demo` run against production.
# ALLOW_DESTRUCTIVE_DB=yes  lets `npm run db:reset` drop a remote schema.
# Both exist to make those actions deliberate. Do not set them in Vercel.
